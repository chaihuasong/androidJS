<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <application
        android:name=".demo.ClawdbotApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AndroidJS">

        <!-- Main Demo Activity -->
        <activity
            android:name=".demo.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Accounting Activity -->
        <activity
            android:name="com.example.androidjs.accounting.ui.AccountingActivity"
            android:exported="false"
            android:label="智能记账" />

        <!-- Chat Activity -->
        <activity
            android:name=".chat.ChatActivity"
            android:exported="false"
            android:label="Clawdbot"
            android:windowSoftInputMode="adjustResize" />

        <!-- Alarm Receiver -->
        <receiver
            android:name="com.example.androidjs.core.modules.AlarmReceiver"
            android:exported="false" />

        <!-- Quran Widget Provider -->
        <receiver
            android:name="com.example.androidjs.widget.QuranWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

    </application>
</manifest>
