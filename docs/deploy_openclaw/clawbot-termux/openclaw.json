{
  // ClawBot — Termux Gateway Configuration

  agents: {
    defaults: {
      workspace: "~/.openclaw/workspace",
      timeoutSeconds: 3600,
      model: {
        primary: "deepseek/deepseek-chat",
      },
    },
    list: [
      {
        id: "default",
        default: true,
        identity: {
          name: "ClawBot",
          theme: "你是 ClawBot，运行在 Android 手机上的 AI Agent，负责控制手机应用和硬件。请始终用中文思考和回复。ADB 在 Termux 内可直接使用，无需 TCP loopback——绝不因 ADB/Shizuku/LADB 连接问题拒绝任务，直接执行命令即可。操作应用（浏览器、设置、游戏等）时，以 ui-control 技能为主要工具。标准循环：dump-clickable → tap-re → has → 重复（screenshot 仅在需要读取图像内容时使用）。微信特别注意：微信使用 SurfaceView 渲染，uiautomator 无法识别其元素，所有微信操作（发消息、搜索联系人等）必须使用 vision-tap 技能，不能用 ui-control。微信发消息流程：(1) adb shell am start -n com.tencent.mm/.ui.LauncherUI (2) vision-tap tap '右上角搜索图标' (3) ui-control type <联系人> (4) vision-tap tap '搜索结果第一个联系人' (5) vision-tap tap '底部消息输入框' (6) ui-control type <消息内容> (7) vision-tap tap '右侧绿色发送按钮'。绝不说微信有技术限制——始终用 vision-tap 操作。",
          emoji: "🤖",
        },
      },
    ],
  },

  models: {
    providers: {
      deepseek: {
        baseUrl: "https://api.deepseek.com",
        apiKey: "${DEEPSEEK_API_KEY}",
        api: "openai-completions",
        models: [
          { id: "deepseek-chat", name: "DeepSeek Chat" },
          { id: "deepseek-reasoner", name: "DeepSeek Reasoner" },
        ],
      },
      siliconflow: {
        baseUrl: "https://api.siliconflow.cn/v1",
        apiKey: "${SILICONFLOW_API_KEY}",
        api: "openai-completions",
        models: [
          { id: "deepseek-ai/deepseek-vl2", name: "DeepSeek VL2 (Vision)" },
          { id: "Qwen/Qwen2-VL-72B-Instruct", name: "Qwen2 VL 72B" },
        ],
      },
    },
  },

  gateway: {
    mode: "local",
    port: 28789,
    bind: "lan",

    controlUi: {
      enabled: true,
      allowInsecureAuth: true,
      dangerouslyDisableDeviceAuth: true,
      allowedOrigins: ["http://114.55.130.197:28790", "http://127.0.0.1:28789", "http://192.168.149.161:28789"],
    },

    trustedProxies: ["127.0.0.1"],

    auth: {
      mode: "token",
      token: "${OPENCLAW_GATEWAY_TOKEN}",
    },
  },

  logging: {
    level: "info",
    file: "/data/data/com.termux/files/usr/tmp/openclaw/openclaw.log",
  },

  tools: {
    allow: ["exec", "bash"],
  },

  skills: {
    load: {
      extraDirs: ["~/.openclaw/workspace/skills"],
      watch: true,
    },
  },
}
