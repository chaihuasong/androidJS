<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/widget_background"
    android:gravity="center">

    <!-- Arabic verse text (RTL) -->
    <TextView
        android:id="@+id/text_arabic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textDirection="rtl"
        android:textAlignment="center"
        android:textSize="22sp"
        android:textColor="#FFFFFF"
        android:fontFamily="serif"
        android:lineSpacingExtra="8dp"
        android:paddingBottom="12dp"
        android:text="بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ" />

    <!-- Translation text -->
    <TextView
        android:id="@+id/text_translation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="14sp"
        android:textColor="#E0E0E0"
        android:lineSpacingExtra="4dp"
        android:paddingBottom="8dp"
        android:text="In the name of Allah, the Most Gracious, the Most Merciful" />

    <!-- Surah reference -->
    <TextView
        android:id="@+id/text_reference"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="12sp"
        android:textColor="#B0BEC5"
        android:textStyle="italic"
        android:paddingBottom="4dp"
        android:text="Al-Fatiha 1:1" />

    <!-- Date display -->
    <TextView
        android:id="@+id/text_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="10sp"
        android:textColor="#90A4AE"
        android:text="" />

</LinearLayout>
